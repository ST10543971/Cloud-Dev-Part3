@model Event

@{
    ViewData["Title"] = "Delete Event";
}

<h1 class="h2 mb-3">Delete Event</h1>
<p class="text-danger">Deleting an event with related bookings will fail until those bookings are removed.</p>
<div asp-validation-summary="All" class="text-danger mb-3"></div>

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.EventName)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.EventName)</dd>
    <dt class="col-sm-3">Venue</dt>
    <dd class="col-sm-9">@Model.Venue?.Name</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="EventId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-link">Back to list</a>  
</form>