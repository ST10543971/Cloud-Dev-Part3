@model IEnumerable<Venue>

@{
    ViewData["Title"] = "Venues";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h2 mb-1">Venues</h1>
        <p class="text-muted mb-0">Manage available venues and their capacity.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Venue</a>
</div>

<form asp-action="Index" method="get" class="row g-3 mb-4">
    <div class="col-md-3">
        <label for="eventTypeId" class="form-label">Event type</label>
        <select id="eventTypeId" name="eventTypeId" class="form-select">
            <option value="">All event types</option>
            @foreach (var eventType in (IEnumerable<EventType>)ViewBag.EventTypes)
            {
                <option value="@eventType.EventTypeId" selected="@(Context.Request.Query["eventTypeId"] == eventType.EventTypeId.ToString() ? "selected" : null)">@eventType.Name</option>
            }
        </select>
    </div>
    <div class="col-md-3">
        <label for="startDate" class="form-label">Event date from</label>
        <input id="startDate" name="startDate" type="date" class="form-control" />
    </div>
    <div class="col-md-3">
        <label for="endDate" class="form-label">Event date to</label>
        <input id="endDate" name="endDate" type="date" class="form-control" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check mb-2">
            <input id="availableOnly" name="availableOnly" value="true" type="checkbox" class="form-check-input" checked="@(Context.Request.Query["availableOnly"] == "true" ? "checked" : null)" />
            <label for="availableOnly" class="form-check-label">Available venues only</label>
        </div>
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-primary">Apply filters</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(model => model.Name)</th>
            <th>@Html.DisplayNameFor(model => model.Location)</th>
            <th>@Html.DisplayNameFor(model => model.Capacity)</th>
            <th>Event Type</th>
            <th>@Html.DisplayNameFor(model => model.IsAvailable)</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Location)</td>
            <td>@Html.DisplayFor(modelItem => item.Capacity)</td>
            <td>@item.EventType?.Name</td>
            <td>@(item.IsAvailable ? "Yes" : "No")</td>
            <td class="text-end">
                <a asp-action="Edit" asp-route-id="@item.VenueId" class="btn btn-sm btn-outline-secondary">Edit</a>
                <a asp-action="Details" asp-route-id="@item.VenueId" class="btn btn-sm btn-outline-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.VenueId" class="btn btn-sm btn-outline-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>